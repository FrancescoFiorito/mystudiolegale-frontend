{
  "expo": {
    "name": "MyStudioLegale",
    "slug": "lexflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.legalcasehub.isoikp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16233E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.legalcasehub.isoikp"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/loading-logo.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#16233E"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Permetti a MyStudioLegale di aggiungere le scadenze al tuo calendario."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "60e6e080-3474-4f1a-8f2f-079ef5f4bc15"
      },
      "router": {}
    },
    "owner": "taxishareexpoacc"
  }
}
